import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

df = pd.read_pickle('df.pkl')
sns.set_theme(style="whitegrid", palette="deep")
plt.rcParams['figure.dpi'] = 150

# 1. Distribution of delivery time
fig, axes = plt.subplots(1, 2, figsize=(11,4.2))
sns.histplot(df['delivery_time_days'], kde=True, ax=axes[0], color="#3b6fa0")
axes[0].set_title("Distribution of Delivery Time (days)")
axes[0].set_xlabel("Delivery Time (days)")
sns.histplot(df['delivery_delay_days'], kde=True, ax=axes[1], color="#c0603b")
axes[1].set_title("Distribution of Delivery Delay (days)")
axes[1].set_xlabel("Delivery Delay (days)")
plt.tight_layout()
plt.savefig('charts/01_distributions.png')
plt.close()

# 2. Correlation heatmap
plt.figure(figsize=(6.5,5.2))
cols = ['shipment_volume','distance_km','delivery_time_days','delivery_delay_days','transport_cost','customer_satisfaction']
corr = df[cols].corr()
sns.heatmap(corr, annot=True, fmt=".2f", cmap="coolwarm", center=0, square=True,
            xticklabels=['Volume','Distance','Del.Time','Del.Delay','Cost','Satisfaction'],
            yticklabels=['Volume','Distance','Del.Time','Del.Delay','Cost','Satisfaction'])
plt.title("Correlation Matrix of Key Logistics Metrics")
plt.tight_layout()
plt.savefig('charts/02_correlation_heatmap.png')
plt.close()

# 3. Transport cost vs distance scatter, colored by mode
plt.figure(figsize=(7,5))
sns.scatterplot(data=df, x='distance_km', y='transport_cost', hue='transport_mode', alpha=0.75, s=45)
plt.title("Transport Cost vs. Distance by Mode")
plt.xlabel("Distance (km)")
plt.ylabel("Transport Cost ($)")
plt.tight_layout()
plt.savefig('charts/03_cost_vs_distance.png')
plt.close()

# 4. Delivery delay by region (boxplot)
plt.figure(figsize=(7,5))
order = df.groupby('region')['delivery_delay_days'].mean().sort_values(ascending=False).index
sns.boxplot(data=df, x='region', y='delivery_delay_days', order=order, palette="Blues_r")
plt.title("Delivery Delay Distribution by Region")
plt.xlabel("Region")
plt.ylabel("Delivery Delay (days)")
plt.tight_layout()
plt.savefig('charts/04_delay_by_region.png')
plt.close()

# 5. Average delivery time & cost by transport mode (grouped bar)
agg = df.groupby('transport_mode')[['delivery_time_days','transport_cost']].mean()
fig, ax1 = plt.subplots(figsize=(7,5))
x = np.arange(len(agg.index))
w = 0.35
ax1.bar(x - w/2, agg['delivery_time_days'], w, label='Avg Delivery Time (days)', color="#3b6fa0")
ax1.set_ylabel("Avg Delivery Time (days)", color="#3b6fa0")
ax1.set_xticks(x); ax1.set_xticklabels(agg.index)
ax2 = ax1.twinx()
ax2.bar(x + w/2, agg['transport_cost'], w, label='Avg Transport Cost ($)', color="#c0603b")
ax2.set_ylabel("Avg Transport Cost ($)", color="#c0603b")
plt.title("Average Delivery Time & Cost by Transport Mode")
fig.tight_layout()
plt.savefig('charts/05_mode_time_cost.png')
plt.close()

# 6. Delivery status counts (on time vs delayed) by transport mode
plt.figure(figsize=(7,5))
status_mode = pd.crosstab(df['transport_mode'], df['delivery_status'], normalize='index') * 100
status_mode.plot(kind='bar', stacked=True, color=["#c0603b","#3b9e5f"], figsize=(7,5))
plt.title("On-Time vs. Delayed Rate by Transport Mode")
plt.xlabel("Transport Mode")
plt.ylabel("% of Shipments")
plt.legend(title="Status")
plt.xticks(rotation=0)
plt.tight_layout()
plt.savefig('charts/06_status_by_mode.png')
plt.close()

# 7. Customer satisfaction vs delivery delay scatter with regression
plt.figure(figsize=(7,5))
sns.regplot(data=df, x='delivery_delay_days', y='customer_satisfaction',
            scatter_kws={'alpha':0.5,'s':30}, line_kws={'color':'#c0603b'})
plt.title("Customer Satisfaction vs. Delivery Delay")
plt.xlabel("Delivery Delay (days)")
plt.ylabel("Customer Satisfaction (1-5)")
plt.tight_layout()
plt.savefig('charts/07_satisfaction_vs_delay.png')
plt.close()

# 8. Monthly shipment volume trend
df['month'] = df['shipment_date'].dt.to_period('M').astype(str)
monthly = df.groupby('month')['shipment_volume'].sum()
plt.figure(figsize=(8,4.5))
monthly.plot(kind='line', marker='o', color="#3b6fa0")
plt.title("Total Shipment Volume Trend by Month")
plt.xlabel("Month")
plt.ylabel("Total Shipment Volume (units)")
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('charts/08_monthly_volume_trend.png')
plt.close()

print("All charts saved.")
import os
print(sorted(os.listdir('charts')))
